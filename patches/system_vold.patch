+/* [0110] 检查 /data 是否已挂载(读 /proc/mounts).
+   真机实测(#111): fscrypt_initialize_systemwide_keys() 跑在 /data 挂载*之前*,
+   而 installKey() 使用 DATA_MNT_POINT="/data" 作为挂载点 ⇒ 挂载点不存在时
+   ioctl 静默失败 ⇒ 内核里*一个 fscrypt key 都没有*(/proc/keys 为空) ⇒
+   /data/system_de/0 等目录的名字永远保持密文. */
+static bool fox_data_is_mounted() {
+	FILE* f = fopen("/proc/mounts", "re");
+	if (f == NULL) return false;
+	char line[4096];
+	bool ok = false;
+	while (fgets(line, sizeof(line), f) != NULL) {
+		if (strstr(line, " /data ") != NULL) { ok = true; break; }
+	}
+	fclose(f);
+	return ok;
+}
