+/* [0068] 在 /data 下有限深度搜索关键文件(keystore 库 / spblob), 输出到 TWRP 日志.
+   目的: A17 把 system_de/<user> 布局改成 /data/system/ 后, 需实测出真实位置. */
+#include <dirent.h>
+#include <sys/stat.h>
+#include <string.h>
+#include <errno.h>
+static void Search_Key_Files(const char *root, int depth, int maxdepth) {
+	if (depth > maxdepth) return;
+	DIR *d = opendir(root);
+	if (!d) return;
+	struct dirent *e;
+	while ((e = readdir(d)) != NULL) {
+		if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+		std::string full = std::string(root) + "/" + e->d_name;
+		struct stat st;
+		if (lstat(full.c_str(), &st) != 0) continue;
+		if (S_ISDIR(st.st_mode)) {
+			/* 跳过明显巨大的数据目录 */
+			if (!strcmp(e->d_name, "media") || !strcmp(e->d_name, "app") ||
+			    !strcmp(e->d_name, "dalvik-cache") || !strcmp(e->d_name, "app-lib") ||
+			    !strcmp(e->d_name, "apex") || !strcmp(e->d_name, "ota_package")) continue;
+			Search_Key_Files(full.c_str(), depth + 1, maxdepth);
+		} else if (S_ISREG(st.st_mode)) {
+			if (strstr(e->d_name, "persistent.sqlite") || strstr(e->d_name, ".pwd") ||
+			    strstr(e->d_name, ".weaver") || strstr(e->d_name, "spblob") ||
+			    strstr(e->d_name, "locksettings")) {
+				printf("[FIND] %s (%lld bytes)\n", full.c_str(), (long long)st.st_size);
+			}
+		}
+	}
+	closedir(d);
+}
