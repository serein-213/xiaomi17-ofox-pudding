+/* [0099] 探测一个 CE 密钥目录是否*真的可用*: 不仅 opendir 成功,
+   还要求能 stat/读取其中的密钥材料. 每次失败都打印 errno —— 真机 v10 曾出现
+   "source=REAL" 之后又 "real ce dir unreadable" 的自相矛盾, 仅靠 opendir 无法定因. */
+static bool fox_probe_ce_dir(const std::string& dir, const char* tag) {
+    errno = 0;
+    DIR* dp = opendir(dir.c_str());
+    if (dp == NULL) {
+        printf("[CE] probe %s %s -> opendir FAILED errno=%d (%s)\n", tag, dir.c_str(), errno, strerror(errno));
+        return false;
+    }
+    struct dirent* e; int n = 0; char first[256] = {0};
+    while ((e = readdir(dp)) != NULL) {
+        if (e->d_name[0] == '.') continue;
+        if (n == 0) snprintf(first, sizeof(first), "%s", e->d_name);
+        n++;
+    }
+    closedir(dp);
+    printf("[CE] probe %s %s -> opendir ok, %d entries%s%s\n", tag, dir.c_str(), n,
+           n ? ", first=" : "", n ? first : "");
+    if (n == 0) { printf("[CE]   %s is EMPTY -> not usable\n", dir.c_str()); return false; }
+    /* 尝试实际读取密钥文件(路径可能是 <dir>/current/encrypted_key 或 <dir>/<entry>/) */
+    const char* suffix[2] = { "/current/encrypted_key", "/current" };
+    for (int i = 0; i < 2; i++) {
+        std::string f = dir + suffix[i];
+        struct stat st;
+        errno = 0;
+        if (stat(f.c_str(), &st) != 0) {
+            printf("[CE]   stat %s FAILED errno=%d (%s)\n", f.c_str(), errno, strerror(errno));
+            continue;
+        }
+        if (!S_ISREG(st.st_mode)) {
+            printf("[CE]   %s is dir (mode=0%o) - listing skipped here\n", f.c_str(), st.st_mode & 07777);
+            /* 目录型: 直接列出它 */
+            DIR* d2 = opendir(f.c_str());
+            if (d2) { struct dirent* e2; int n2 = 0;
+                while ((e2 = readdir(d2)) != NULL && n2 < 10) { if (e2->d_name[0]=='.') continue; printf("[CE]     %s\n", e2->d_name); n2++; }
+                closedir(d2);
+            }
+            return true;
+        }
+        errno = 0;
+        int fd = open(f.c_str(), O_RDONLY);
+        if (fd < 0) { printf("[CE]   open %s FAILED errno=%d (%s)\n", f.c_str(), errno, strerror(errno)); continue; }
+        errno = 0;
+        char b[8]; ssize_t r = read(fd, b, sizeof(b));
+        int rerr = errno;
+        close(fd);
+        if (r < 0) { printf("[CE]   read %s FAILED errno=%d (%s)\n", f.c_str(), rerr, strerror(rerr)); continue; }
+        printf("[CE]   read %s -> %zd bytes OK (%zu bytes total)\n", f.c_str(), r, (size_t)st.st_size);
+        return true;
+    }
+    printf("[CE]   %s : opendir ok but no readable key material -> not usable\n", dir.c_str());
+    return false;
+}
