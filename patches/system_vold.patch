+/* [0101] 正确读取目录的 fscrypt 策略(支持 v2).
+   旧实现用 FS_IOC_GET_ENCRYPTION_POLICY(v1 结构) 查 v2 策略必然 EINVAL,
+   导致"所有目录都报 no policy"的假象 —— 该结论作废. */
+static int fox_get_policy(const char* dir, uint8_t desc_out[8], uint8_t* ver_out,
+                          uint8_t* cmode_out, uint8_t* fmode_out, uint32_t* flags_out) {
+    int fd = open(dir, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (fd < 0) return -errno;
+    struct fscrypt_get_policy_ex_arg arg;
+    memset(&arg, 0, sizeof(arg));
+    arg.policy_size = sizeof(arg.policy);
+    if (ioctl(fd, FS_IOC_GET_ENCRYPTION_POLICY_EX, &arg) != 0) {
+        int e = errno;
+        close(fd);
+        return -e;
+    }
+    close(fd);
+    if (desc_out) memset(desc_out, 0, 8);
+    if (arg.policy.version == FSCRYPT_POLICY_V2) {
+        auto& p2 = arg.policy.v2;
+        if (ver_out)   *ver_out = 2;
+        if (cmode_out) *cmode_out = p2.contents_encryption_mode;
+        if (fmode_out) *fmode_out = p2.filenames_encryption_mode;
+        if (flags_out) *flags_out = p2.flags;
+        if (desc_out)  memcpy(desc_out, p2.master_key_identifier, 8);
+    } else if (arg.policy.version == FSCRYPT_POLICY_V1) {
+        auto& p1 = arg.policy.v1;
+        if (ver_out)   *ver_out = 1;
+        if (cmode_out) *cmode_out = p1.contents_encryption_mode;
+        if (fmode_out) *fmode_out = 0;
+        if (flags_out) *flags_out = p1.flags;
+        if (desc_out)  memcpy(desc_out, p1.master_key_descriptor, 8);   /* v1 字段名不同 */
+    } else {
+        return -EINVAL;
+    }
+    return 0;
+}
