+    uint8_t d[8], v = 0, cm = 0, fm = 0; uint32_t fl = 0;
+    int r = fox_get_policy(dir, d, &v, &cm, &fm, &fl);
+    if (r != 0) {
+        printf("[POL] %s %s -> ioctl errno=%d (%s)\n", tag, dir, -r, strerror(-r));
+        return;
+    }
+    printf("[POL] %s %s -> v%u desc=%02x%02x%02x%02x%02x%02x%02x%02x contents=%u filenames=%u flags=0x%x\n",
+           tag, dir, v, d[0],d[1],d[2],d[3],d[4],d[5],d[6],d[7], cm, fm, fl);
