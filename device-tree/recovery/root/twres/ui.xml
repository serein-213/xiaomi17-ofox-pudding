<?xml version="1.0"?>
<!-- OrangeFox theme by fordownloads and OrangeFox team -->
<recovery>
	<details>
		<!-- [0134] 屏幕 1220x2656(宽高比 2.177), 而主题按 1080x1920(1.778) 设计.
		     原写法缺少 resizing 属性 ⇒ pages.cpp:924-930 会**忽略这里的 height**,
		     改用真实屏幕高度 2656 计算 ⇒ scale_w=1220/1080=1.1296 与
		     scale_h=2656/1920=1.3833 不等 ⇒ 非等比拉伸, 卡片/头像错位.
		     修正: 补上 resizing 属性让 height 生效, 并把 height 取为等比所需值
		     1080*2656/1220 = 2351 ⇒ scale_w == scale_h == 1.1296 > 不再变形. -->
		<resolution width="1080" height="2351" resizing="1" />
		<themeversion>3</themeversion>
	</details>
	
	<include>

		<xml name="%fox_navbar_path%/navbar.xml" default="/twres/themes/navbar.xml"/>
		<xml name="%fox_theme_path%/font.xml"    default="/twres/themes/font.xml"/>
		<xml name="%fox_theme_path%/style.xml"   default="/twres/themes/style.xml"/>
		<xml name="%fox_theme_path%/accent.xml"  default="/twres/themes/accent.xml"/>
		<xml name="%fox_theme_path%/action.xml"  default="/twres/themes/action.xml"/>

		<xml name="/twres/resources/images.xml"/>
		<xml name="/twres/resources/vars.xml"/>
		<xml name="/twres/resources/styles.xml"/>
	
		<xml name="/twres/pages/templates/base.xml"/>
		<xml name="/twres/pages/templates/keyboard.xml"/>
		<xml name="/twres/pages/templates/navbar.xml"/>
		<xml name="/twres/pages/templates/statusbar.xml"/>
		<xml name="/twres/pages/templates/templates.xml"/>
		
		<xml name="/twres/pages/main.xml"/>
		<xml name="/twres/pages/pass.xml"/>
		<xml name="/twres/pages/install.xml"/>
		<xml name="/twres/pages/wipe.xml"/>
		<xml name="/twres/pages/backup.xml"/>
		<xml name="/twres/pages/restore.xml"/>
		<xml name="/twres/pages/mount.xml"/>
		<xml name="/twres/pages/files.xml"/>
		<xml name="/twres/pages/rmmanager.xml"/>
		<xml name="/twres/pages/advanced.xml"/>
		<xml name="/twres/pages/reboot.xml"/>
		<xml name="/twres/pages/settings.xml"/>
		<xml name="/twres/pages/universal.xml"/>
		<xml name="/twres/pages/anywhere.xml"/>
		<xml name="/twres/pages/dialogs.xml"/>
		<xml name="/twres/pages/customization.xml"/>
		<xml name="/twres/pages/wlan.xml"/>

		<xml name="/twres/pages/fox.xml"/>
		<xml name="/sbin/maintainer.xml" default="/twres/pages/dummy.xml"/>

		<xmlfile name="pages/recovery.xml"/>
	</include>
	<variables>
		<variable name="magisk_ver" value="20.3"/>
		<variable name="fox_theme_version" value="1.1"/>
	</variables>
</recovery>
